{
  "name": "sitelens",
  "version": "1.0.1",
  "private": true,
  "description": "A Chrome extension for checking suspicious website signals.",
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "demo": "node scripts/demo-server.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "package": "python3 scripts/package.py"
  },
  "dependencies": {
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
