{
  "manifest_version": 3,
  "name": "SiteLens — Website Inspector",
  "version": "1.0.1",
  "description": "Check a page’s domain, password forms, and links locally.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "popup.html", "default_title": "Inspect this page with SiteLens", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Open SiteLens" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
}
